# ==========================================
# SCANOVA ENVIRONMENT VARIABLES (.env.example)
# ==========================================

# --- Frontend Configuration ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set this to your Railway deployment URL after deploying the ML service
# Example: https://scanova-ml-service.up.railway.app
VITE_ML_SERVICE_URL=http://localhost:8000


# --- ML Service Configuration (Railway) ---
# Supabase URL (supports SUPABASE_URL or VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Key (service role key recommended for production backend, or anon key)
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Server Port (Railway sets PORT automatically)
PORT=8000
HOST=0.0.0.0
