# Supabase Configuration
# The ML service supports SUPABASE_URL or VITE_SUPABASE_URL
SUPABASE_URL=https://your-project-id.supabase.co
# The ML service supports SUPABASE_KEY, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, or VITE_SUPABASE_ANON_KEY
SUPABASE_KEY=your-supabase-key-here

# Server Configuration
PORT=8000
HOST=0.0.0.0
